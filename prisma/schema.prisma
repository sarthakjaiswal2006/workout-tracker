generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts        Workout[]
  personalRecords PersonalRecord[]
  miniGameScores  MiniGameScore[]
}

model Exercise {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  equipment   String
  category    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  muscleGroups     ExerciseMuscleGroup[]
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@index([name])
  @@index([category])
  @@index([equipment])
}

model MuscleGroup {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  exercises ExerciseMuscleGroup[]
}

model ExerciseMuscleGroup {
  exerciseId    String  @db.Uuid
  muscleGroupId String  @db.Uuid
  isPrimary     Boolean @default(false)

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model Workout {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String    @default("IN_PROGRESS")
  notes     String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises WorkoutExercise[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

model WorkoutExercise {
  id       String  @id @default(uuid()) @db.Uuid
  position Int
  notes    String?

  workoutId  String @db.Uuid
  exerciseId String @db.Uuid

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSet[]

  @@unique([workoutId, position])
  @@index([exerciseId])
}

model WorkoutSet {
  id        String   @id @default(uuid()) @db.Uuid
  setNumber Int
  setType   String   @default("NORMAL")
  weight    Decimal  @db.Decimal(7, 2)
  reps      Int
  rpe       Decimal? @db.Decimal(3, 1)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  workoutExerciseId String          @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  personalRecords PersonalRecord[]

  @@unique([workoutExerciseId, setNumber])
}

model PersonalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  recordType String
  value      Decimal  @db.Decimal(10, 2)
  achievedAt DateTime @default(now())

  userId       String @db.Uuid
  exerciseId   String @db.Uuid
  workoutSetId String @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutSet WorkoutSet @relation(fields: [workoutSetId], references: [id], onDelete: Cascade)

  @@unique([workoutSetId, recordType])
  @@index([userId, exerciseId, recordType, achievedAt])
}

model MiniGameScore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  game      String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, score])
  @@index([userId])
}
